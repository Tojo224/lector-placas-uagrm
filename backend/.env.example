APP_NAME=Lector de Placas UAGRM
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS='["https://localhost:5173"]'
# Elige UNA URL. PostgreSQL es una dependencia externa de la aplicacion:
# Backend en el host + PostgreSQL instalado:
#   postgresql+psycopg://usuario:clave@localhost:5432/base
# Backend en Docker + PostgreSQL instalado en el host (Docker Desktop):
#   postgresql+psycopg://usuario:clave@host.docker.internal:5432/base
# PostgreSQL externo:
#   postgresql+psycopg://usuario:clave@postgres.example.com:5432/base
# Neon (SSL obligatorio):
#   postgresql+psycopg://usuario:clave@ep-example-pooler.neon.tech/base?sslmode=require&channel_binding=require
DATABASE_URL=postgresql+psycopg://usuario:clave@postgres.example.com:5432/base

# Auth
SECRET_KEY=change-this-in-env-secret-key-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15

FAST_ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
FAST_PLATE_OCR_MODEL=cct-xs-v2-global-model
FAST_ALPR_DETECTOR_CONFIDENCE=0.40
FAST_ALPR_EXECUTION_PROVIDER=CPUExecutionProvider
OCR_CONFIDENCE_THRESHOLD=0.55
OCR_UPSCALE_FACTOR=2.0
OCR_USE_GRAYSCALE=true
OCR_USE_CONTRAST=true
OCR_DENOISE=true
OCR_USE_THRESHOLD=false
OCR_ROI_X=
OCR_ROI_Y=
OCR_ROI_WIDTH=
OCR_ROI_HEIGHT=
CAMERA_INDEX=0
CAMERA_RTSP_URL=
CAMERA_API_URL=http://127.0.0.1:8000/api/v1/plates/analyze
CAMERA_ANALYSIS_INTERVAL_SECONDS=2.0
CAMERA_DUPLICATE_COOLDOWN_SECONDS=30.0
CAMERA_RECONNECT_DELAY_SECONDS=5.0
CAMERA_REQUEST_TIMEOUT_SECONDS=30.0
CAMERA_REQUEST_RETRIES=2
CAMERA_REQUEST_RETRY_DELAY_SECONDS=1.0
CAMERA_JPEG_QUALITY=90

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Cloudinary (solo backend; nunca usar prefijo VITE_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_ASSET_PREFIX=placas-academico
CLOUDINARY_DELIVERY_TYPE=authenticated

# Procesamiento y retencion multimedia
MEDIA_USER_SIZE=512
MEDIA_VEHICLE_MAX_DIMENSION=1600
MEDIA_ACCESS_MAX_DIMENSION=1600
MEDIA_PERMANENT_WEBP_QUALITY=82
MEDIA_ACCESS_WEBP_QUALITY=78
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_ACCESS_RETENTION_DAYS=90
MEDIA_UPLOAD_MAX_RETRIES=3
MEDIA_SPOOL_DIR=.runtime/media-spool

